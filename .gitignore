!tools/rootAVD/README.md
!tools/rootAVD/CompatibilityChart.md
!tools/rootAVD/frida.rc
!tools/rootAVD/rootAVD.sh
!tools/rootAVD/rootAVD.bat

# Nested vendor repo metadata. Keep source files, not their local git histories.
tools/**/.git/

# Android packages and capture dumps.
*.apk
*.apks
*.aab
*.pcap
*.har
*.db
*.sqlite

# Local environment overrides.
.env
.env.*
!.env.example
config/local.json
