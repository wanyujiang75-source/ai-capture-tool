{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI抓包工具",
  "version": "1.0.0",
  "identifier": "com.local.ai-capture-tool",
  "build": {
    "frontendDist": "../desktop/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AI抓包工具",
        "url": "index.html",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      "../capture_console": "capture_console",
      "../scripts": "scripts",
      "../requirements-console.txt": "requirements-console.txt",
      "../web/dist": "web/dist",
      "../desktop/start-backend.sh": "desktop/start-backend.sh",
      "../config/local.example.json": "config/local.example.json",
      "../config/devices.macmini.json.example": "config/devices.macmini.json.example",
      "../tools/httptoolkit-frida": "tools/httptoolkit-frida"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
